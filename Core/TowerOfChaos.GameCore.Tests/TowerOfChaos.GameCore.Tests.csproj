<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner with no NuGet dependencies (works offline / in CI). Exit code 1 on any failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TowerOfChaos.GameCore.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TowerOfChaos.GameCore\TowerOfChaos.GameCore.csproj" />
    <Content Include="..\Data\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
