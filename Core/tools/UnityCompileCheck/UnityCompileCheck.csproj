<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the real Unity glue scripts against stubs + the real Core library (no Unity needed). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <RootNamespace>UnityCompileCheck</RootNamespace>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\UnityClient\Assets\_Project\Scripts\*.cs" LinkBase="UnityClient" />
    <ProjectReference Include="..\..\TowerOfChaos.GameCore\TowerOfChaos.GameCore.csproj" />
  </ItemGroup>

</Project>
